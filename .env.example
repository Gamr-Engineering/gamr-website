# Supabase frontend configuration
# Copy this file to .env and replace the placeholders.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Do not put private service role keys, email provider keys, or backend-only
# secrets in VITE_ variables. Vite exposes VITE_ variables to browser code.

